{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modu.solvable.v1.3.schema.json",
  "title": "Modu Solvable Schema v1.3",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "given_item": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "value": {},
        "unit": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["id", "value"]
        },
        {
          "required": ["ref", "value"]
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["id"]
        },
        {
          "required": ["ref"]
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "expr": {
          "type": "string"
        },
        "value": {},
        "explanation": {
          "type": "string"
        }
      },
      "required": ["expr", "value"]
    },
    "check": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "diagnostic_rule": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "wrong_value": {},
        "wrong_pattern": {
          "type": "string"
        },
        "wrong_min": {
          "type": "number"
        },
        "wrong_max": {
          "type": "number"
        },
        "condition": {
          "type": "string"
        },
        "concept": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        }
      },
      "required": ["id", "concept", "reason", "feedback"],
      "anyOf": [
        {
          "required": ["wrong_value"]
        },
        {
          "required": ["wrong_pattern"]
        },
        {
          "required": ["wrong_min"]
        },
        {
          "required": ["wrong_max"]
        },
        {
          "required": ["condition"]
        }
      ]
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic_code_rule"
          }
        }
      }
    },
    "diagnostic_code_rule": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "required": ["condition", "code"]
    },
    "answer_key_item": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "slot_id": {
          "type": "string"
        },
        "value": {},
        "unit": {
          "type": "string"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic_rule"
          }
        }
      },
      "required": ["slot_id", "value"]
    },
    "answer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "value": {},
        "unit": {
          "type": "string"
        },
        "answer_key": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer_key_item"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic_rule"
          }
        }
      },
      "required": ["value", "unit"]
    },
    "student_hint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["level", "text"]
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "const": "modu.solvable.v1.3"
    },
    "problem_id": {
      "type": "string"
    },
    "problem_type": {
      "type": "string"
    },
    "given": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/given_item"
      }
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "method": {
      "type": "string"
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "answer": {
      "$ref": "#/$defs/answer"
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    },
    "student_hints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/student_hint"
      }
    }
  },
  "required": [
    "schema",
    "problem_id",
    "given",
    "target",
    "method",
    "steps",
    "answer"
  ]
}
